<Page
    x:Class="DonutErp.UI.Views.Pages.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DonutErp.Core.Entities"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="20" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Gudang &amp; Bahan Baku" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Monitor stok, harga beli, dan aset inventory." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Total Nilai Aset" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalInventoryAssetValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" 
                               Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Stok Menipis" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="Red"/>
                        <TextBlock Text="{x:Bind ViewModel.LowStockItemCount, Mode=OneWay}" 
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="Red"/>
                        <TextBlock Text="Items" VerticalAlignment="Bottom" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox PlaceholderText="Cari Bahan Baku (Nama / SKU)..." 
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyUp="TextBox_KeyUp">
                <TextBox.Header>
                    <TextBlock Text="Pencarian Cepat" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4"/>
                </TextBox.Header>
            </TextBox>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                
                <Button Command="{x:Bind ViewModel.LoadDataCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;"/>
                        <TextBlock Text="Refresh Data"/>
                    </StackPanel>
                </Button>
                
                <Button Style="{StaticResource AccentButtonStyle}" 
                        Command="{x:Bind ViewModel.StockOpnameCommand}"
                        ToolTipService.ToolTip="Pilih item di tabel untuk melakukan penyesuaian stok">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D5;"/>
                        <TextBlock Text="Stock Opname"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{ThemeResource LayerFillColorAltBrush}" Padding="12,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="NAMA BAHAN" Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Text="SKU / KODE" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Text="STOK SAAT INI" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Text="SATUAN" Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0"/>
                <TextBlock Text="HARGA @ (HPP)" Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Text="VALUASI" Grid.Column="5" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            </Grid>

            <ListView Grid.Row="1" 
                      ItemsSource="{x:Bind ViewModel.Ingredients, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedIngredient, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Ingredient">
                        <Grid Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>

                            <TextBlock Grid.Column="1" Text="{x:Bind Sku}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <TextBlock Grid.Column="2" Text="{x:Bind CurrentStock}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"/>

                            <TextBlock Grid.Column="3" Text="{x:Bind UsageUnit}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <TextBlock Grid.Column="4" Text="{x:Bind AvgCostPerUsageUnit, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Column="5" Text="-" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                          Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>