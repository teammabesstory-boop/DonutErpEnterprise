<Page
    x:Class="DonutErp.UI.Views.Pages.PosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DonutErp.Core.Entities"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox PlaceholderText="Cari Menu (Donat, Minuman)...">
                    <TextBox.Header>
                        <TextBlock Text="Katalog Menu" Style="{StaticResource TitleTextBlockStyle}"/>
                    </TextBox.Header>
                </TextBox>

                <Button Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0" Command="{x:Bind ViewModel.LoadProductsCommand}">
                    <FontIcon Glyph="&#xE72C;"/>
                </Button>
            </Grid>

            <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Products, Mode=OneWay}" SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Button Style="{StaticResource DateTimePickerFlyoutButtonStyle}" 
                                Width="160" Height="120" Margin="4" Padding="0"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Command="{Binding ElementName=PosRoot, Path=ViewModel.AddToCartCommand}"
                                CommandParameter="{Binding}">

                            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <FontIcon Glyph="&#xE781;" FontSize="48" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <StackPanel Grid.Row="1" Padding="12" Background="{ThemeResource LayerFillColorAltBrush}">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind SellingPrice, Converter={StaticResource CurrencyConverter}}" 
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="20" Background="{ThemeResource LayerFillColorAltBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Pesanan Baru" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.CartItems.Count, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}Total Items: {0}'}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                        Command="{x:Bind ViewModel.ClearCartCommand}">
                    <FontIcon Glyph="&#xE74D;" Foreground="Red" FontSize="16"/>
                </Button>
            </Grid>

            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}" SelectionMode="None" Padding="12">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionDetail">
                        <Grid Padding="0,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Product.Name}" FontWeight="Medium"/>
                                <TextBlock Text="{x:Bind PriceAtSale, Converter={StaticResource CurrencyConverter}}" 
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock Text="x" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{x:Bind Quantity}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="2" Padding="8" Background="Transparent" BorderThickness="0"
                                    Command="{Binding ElementName=PosRoot, Path=ViewModel.RemoveFromCartCommand}"
                                    CommandParameter="{Binding}">
                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="Red"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Padding="20" Spacing="16" Background="{ThemeResource LayerFillColorAltBrush}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">

                <Grid>
                    <TextBlock Text="Total Tagihan" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" 
                               HorizontalAlignment="Right" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                </Grid>

                <NumberBox Header="Uang Diterima (Rp)" PlaceholderText="Masukkan nominal..." 
                           Value="{x:Bind ViewModel.PaymentAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                           Minimum="0"/>

                <Grid Visibility="{x:Bind ViewModel.PaymentAmount, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock Text="Kembalian" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.ChangeAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" 
                               HorizontalAlignment="Right" FontWeight="Bold" Foreground="Green"/>
                </Grid>

                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12"
                        Command="{x:Bind ViewModel.ProcessCheckoutCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE825;"/>
                        <TextBlock Text="PROSES BAYAR" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Grid.RowSpan="3" Background="#80000000" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <ProgressRing IsActive="True" Width="50" Height="50"/>
            </Grid>
        </Grid>
    </Grid>

    <Page.Resources>
    </Page.Resources>
</Page>