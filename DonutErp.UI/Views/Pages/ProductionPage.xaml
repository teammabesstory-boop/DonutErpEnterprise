<Page
    x:Class="DonutErp.UI.Views.Pages.ProductionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DonutErp.Core.Entities"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Dapur Produksi (Daily Batch)" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Input hasil produksi harian dan analisa penggunaan minyak." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="16">
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Informasi Batch" Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <TextBox Header="Kode Batch (Auto)" Text="{x:Bind ViewModel.BatchCode, Mode=OneWay}" IsReadOnly="True" IsEnabled="False"/>

                        <DatePicker Header="Tanggal Produksi" Date="{x:Bind ViewModel.ProductionDate, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7B3;" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock Text="Analisa Minyak" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        </StackPanel>
                        <TextBlock Text="Input dalam Satuan Liter" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <NumberBox Header="Level Awal (Start)" Value="{x:Bind ViewModel.OilStartLevel, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline"/>

                        <NumberBox Header="Tambah Minyak (Topup)" Value="{x:Bind ViewModel.OilAdded, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline"/>

                        <NumberBox Header="Level Akhir (End)" Value="{x:Bind ViewModel.OilEndLevel, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline"
                                   Description="Ukur sisa minyak setelah selesai goreng"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.ColumnSpacing>12</Grid.ColumnSpacing>

                    <ComboBox Header="Pilih Produk" Grid.Column="0" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.AvailableProducts, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedProductToAdd, Mode=TwoWay}"
                              DisplayMemberPath="Name" PlaceholderText="Cari Donat..."/>

                    <NumberBox Header="Hasil Bagus" Grid.Column="1" Value="{x:Bind ViewModel.QtyGoodInput, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact"/>

                    <NumberBox Header="Reject/Bantat" Grid.Column="2" Value="{x:Bind ViewModel.QtyRejectInput, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact"/>

                    <Button Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddToBatchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;"/>
                            <TextBlock Text="Tambah"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NAMA PRODUK" VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Grid.Column="1" Text="QTY BAGUS" VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Grid.Column="2" Text="QTY REJECT" VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Grid.Column="3" Text="AKSI" VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.BatchOutputs, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProductionOutput">
                                <Grid Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind Product.Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind QuantityGood}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind QuantityReject}" VerticalAlignment="Center" Foreground="Red"/>

                                    <Button Grid.Column="3" Padding="6" Background="Transparent" BorderThickness="0" 
                                            Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveFromBatchCommand}" 
                                            CommandParameter="{Binding}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="Red"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" 
                                Visibility="{x:Bind ViewModel.BatchOutputs.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                        <FontIcon Glyph="&#xE7B0;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Belum ada donat di batch ini" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,24,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="Pastikan data minyak sudah benar sebelum proses."/>
                </TextBlock>
                <Button Content="Proses Produksi &amp; Hitung HPP" Style="{StaticResource AccentButtonStyle}" 
                        Command="{x:Bind ViewModel.SubmitBatchCommand}" 
                        FontSize="16" Padding="24,12"/>
            </StackPanel>
        </Border>

        <Grid Grid.RowSpan="3" Background="#80000000" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <ProgressRing IsActive="True" Width="60" Height="60"/>
        </Grid>
    </Grid>
</Page>